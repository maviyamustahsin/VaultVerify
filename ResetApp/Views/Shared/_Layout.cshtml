    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>VaultVerify - Secure Auth Platform</title>
    <link rel="stylesheet" href="~/css/vaultverify.css?v=@DateTime.Now.Ticks" asp-append-version="true" />
