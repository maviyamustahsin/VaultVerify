<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%;">
    <div class="auth-card">
        <div class="security-tag">Live Protection</div>
        <div class="vv-logo">
            <div class="vv-logo-square">V</div>
            <div class="vv-logo-text">VaultVerify</div>
        </div>
        
        <h2>Identity</h2>
        <p>Please enter your email to access your secure vault and manage your identity.</p>

        @if (ViewBag.Message != null)
        {
            <div class="alert-vv">@ViewBag.Message</div>
        }

        <form id="identifyForm" method="post" action="@Url.Action("Identify")">
            @Html.AntiForgeryToken()
            <div class="input-group">
                <input type="email" name="email" placeholder="Enter your email" required />
            </div>
            
            <p style="font-size: 14px; color: var(--primary); margin-bottom: 24px; cursor: pointer; font-weight: 500;" onclick="location.href='@Url.Action("Register")'">
                No account? Create one now
            </p>

            <button type="submit" class="btn-vv">Verify Identity</button>
        </form>
    </div>

    <div style="margin-top: 32px; display: flex; gap: 24px; font-size: 13px;">
        <a href="@Url.Action("Privacy")" class="btn-link" style="color: rgba(255,255,255,0.7); text-decoration: none;">Privacy Policy</a>
        <a href="@Url.Action("ExportLogs")" class="btn-link" style="color: rgba(255,255,255,0.7); text-decoration: none;">Compliance Log</a>
    </div>
</div>
