<div id="biometric-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15, 23, 42, 0.9); z-index:1000; flex-direction:column; align-items:center; justify-content:center; color: white;">
    <div class="scan-container" style="border-color: var(--secondary); background: rgba(6, 182, 212, 0.05);">
        <div class="scan-pulse"></div>
        <div style="font-size: 48px; margin-bottom: 10px;">👤</div>
    </div>
    <div style="margin-top:20px; font-weight:700; font-size:22px; letter-spacing: 1px; text-transform: uppercase;">Identity Verification</div>
    <div style="margin-top:8px; font-size:14px; opacity: 0.7;">Authenticating via VaultVerify Secure Layer...</div>
</div>

<div style="display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%;">
    <div class="auth-card">
        <div class="security-tag">Live Protection</div>
        <div class="vv-logo">
            <div class="vv-logo-square">V</div>
            <div class="vv-logo-text">VaultVerify</div>
        </div>
        
        <h2>Identity</h2>
        <p>Please enter your email to access your secure vault and manage your identity.</p>

        @if (ViewBag.Message != null)
        {
            <div class="alert-vv">@ViewBag.Message</div>
        }

        <form id="identifyForm" method="post" onsubmit="showScan()">
            @Html.AntiForgeryToken()
            <div class="input-group">
                <input type="email" name="email" placeholder="Enter your email" required />
            </div>
            
            <p style="font-size: 14px; color: var(--primary); margin-bottom: 24px; cursor: pointer; font-weight: 500;" onclick="location.href='@Url.Action("Register")'">
                No account? Create one now
            </p>

            <button type="submit" class="btn-vv">Verify Identity</button>
        </form>
    </div>

    <div style="margin-top: 32px; display: flex; gap: 24px; font-size: 13px;">
        <a href="@Url.Action("Privacy")" class="btn-link" style="color: rgba(255,255,255,0.7); text-decoration: none;">Privacy Policy</a>
        <a href="@Url.Action("ExportLogs")" class="btn-link" style="color: rgba(255,255,255,0.7); text-decoration: none;">Compliance Log</a>
    </div>
</div>

<script>
    function showScan() {
        document.getElementById("biometric-overlay").style.display = "flex";
        // Let the form submit normally (the scan shows while the page is changing)
    }
</script>

<style>
    @@keyframes scan {
        0% { top: 0; }
        50% { top: 100%; }
        100% { top: 0; }
    }
</style>
