<div class="auth-card">
    <div class="security-tag">Verification</div>
    <div class="vv-logo">
        <div class="vv-logo-square">V</div>
        <div class="vv-logo-text">VaultVerify</div>
    </div>

    <h2>Confirm Access</h2>
    <div style="font-size: 14px; margin-bottom: 24px;">
        Sending code to <strong style="color: var(--primary);">@ViewBag.Email</strong>
        <a href="@Url.Action("Identify")" style="margin-left:8px; font-size: 12px; font-weight: 700;">Edit email</a>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert-vv">@ViewBag.Message</div>
    }

    <form method="post">
        <input type="hidden" name="email" value="@ViewBag.Email" />
        <div class="input-group">
            <input type="text" name="code" placeholder="Enter security code" required style="font-size: 24px; text-align: center; letter-spacing: 4px;" />
        </div>

        <div class="timer-vv" id="timer">Expires in: 60s</div>

        <p style="font-size: 14px; margin-bottom: 24px; opacity: 0.8;">
            Check your inbox for a 6-digit verification code.
        </p>

        <button type="submit" class="btn-vv">Verify & Continue</button>
    </form>
</div>

<script>
    let timeLeft = 60;
    const timerElement = document.getElementById("timer");
    const interval = setInterval(() => {
        if (timeLeft <= 0) {
            clearInterval(interval);
            timerElement.textContent = "Security code expired.";
            timerElement.style.color = "var(--error)";
        } else {
            timeLeft--;
            timerElement.textContent = `Expires in: ${timeLeft}s`;
        }
    }, 1000);
</script>

<div style="margin-top: 24px; text-align: center; font-size: 12px; color: rgba(255,255,255,0.4);">
    Protected by VaultVerify Multi-Layer Security
</div>
